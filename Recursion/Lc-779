class Solution {
public:
    int dfs(int n, int k) {
        if (n == 1) {
            return 0;
        }

        int ans = dfs(n - 1, (k + 1) / 2);

        if (k % 2 == 0) {
            ans = 1 - ans;
        }

        return ans;
    }

    int kthGrammar(int n, int k) {
        return dfs(n, k);
    }
};
