class Solution {
  public:
    bool areAnagrams(string& s1, string& s2) {
        // code here
        unordered_map<char,int> mp;

        for(char ch : s1)
        mp[ch]++;

        for(char c: s2)
        mp[c]--;


        for(auto it : mp)
        if(it.second!=0)
        return false;

        return true;




    }
};
