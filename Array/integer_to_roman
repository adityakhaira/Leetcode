#include<bits/stdc++.h>
using namespace std;

int main()
{
   
   int n; 
   cin>>n;
   
   vector<int> val={1000,900,500,400,100,90,50,40,10,9,5,4,1};
   vector<string> symbol ={"M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I"};
   
   string ans="";
   
   for(int i=0; i<val.size(); i++)
   {
       while(n>=val[i])
       {
           ans+=symbol[i];
           n-=val[i];
           
       }
       
   }
   
   cout<<ans;
    
  return 0;
}
