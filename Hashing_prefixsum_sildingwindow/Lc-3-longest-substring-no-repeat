//longest substring without hh
class Solution {
public:
    int lengthOfLongestSubstring(string s) {

        unordered_map<char,int> mp;
        int max_len=0;
        int l=0;


        for(int r=0 ; r<s.size() ; r++)
        {
            mp[s[r]]++;

            while(mp[s[r]]>1)
            {
                mp[s[l]]--;
                l++;
            }

            max_len=max(max_len,r-l+1);
        
        }

        return max_len;
        
    }
};
