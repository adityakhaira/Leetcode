#include <bits/stdc++.h>
using namespace std;

int setbit(int n)
{
    int count=0;
    while(n>0)
    {
        if(n%2!=0)
        count++;
        n=n/2;
    }
    
    return count;
}

int main() {
	int n;
	cin>>n;
	
	vector<int> ans;
	
	for(int i=0; i<=n; i++){
	int x=setbit(i);
	ans.push_back(x);
	}
	
	for(int i=0; i<=n; i++){
	    cout<<ans[i];
	}
	
	
	return 0;
	

}
