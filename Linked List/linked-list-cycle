/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    bool hasCycle(ListNode *head) {
        /*unordered_set<ListNode*> mark;
        ListNode* curr=head;
        while(curr!=NULL)
        {
            if(mark.count(curr))
            {
                return true;
            }
            mark.insert(curr);
            curr=curr->next;
        }
        return false;
        // slow fast pointer method no extra space
        ListNode*  slow=head;
        ListNode*  fast=head;
        while(fast!=NULL && fast->next!=NULL)
        {   
            slow=slow->next;
            fast=fast->next->next;
            if(fast==slow)
            {
                return true;
            }

        }
        return false;

         

        
    }
};